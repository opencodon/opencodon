-def _request(
-    method: str,
-    path: str,
-    *,
-    body: Optional[dict[str, Any]] = None,
-    extra_headers: Optional[dict[str, str]] = None,
-    timeout: float = DEFAULT_TIMEOUT,
-    _retried_auth: bool = False,
