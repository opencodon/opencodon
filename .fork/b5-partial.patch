-                ) from exc
-            except Exception as exc:
-                raise RuntimeError(
-                    f"Failed to refresh Nous Portal credentials: {exc}"
-                ) from exc
-
-            runtime_key = refreshed.get("api_key")
-            if not runtime_key:
