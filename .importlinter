[importlinter]
root_packages =
    opencodon
include_external_packages = True

# Target layering (docs/plans/2026-08-01-repo-restructure-plan.md):
#   opencodon.frontends.* (cli incl. shell, gateway, tui, acp, mcp)
#     -> opencodon.core / opencodon.tools / opencodon.cron
#     -> opencodon config/state/plugins_runtime/providers -> opencodon.common
# Frontends must not import each other. ignore lists are shrink-only.

[importlinter:contract:core-not-cli-frontend]
name = opencodon.core must not import the CLI frontend
type = forbidden
source_modules = opencodon.core
forbidden_modules = opencodon.frontends.cli
allow_indirect_imports = True
ignore_imports =
    opencodon.core.auth -> opencodon.frontends.cli.curses_ui
    opencodon.core.models -> opencodon.frontends.cli.model_switch
    opencodon.core.profiles -> opencodon.frontends.cli.gateway
    opencodon.core.profiles -> opencodon.frontends.cli.service_manager
    opencodon.core.gemini_native_adapter -> opencodon.frontends.cli
    opencodon.core.coding_context -> opencodon.frontends.cli.tools_config
    opencodon.core.conversation_compression -> opencodon.frontends.cli.goals
    opencodon.core.display -> opencodon.frontends.cli.skin_engine
    opencodon.core.lsp.install -> opencodon.frontends.cli.tools_config
    opencodon.core.prompt_builder -> opencodon.frontends.cli.projects_db
    opencodon.core.run_agent -> opencodon.frontends.cli
    opencodon.core.skill_commands -> opencodon.frontends.cli.commands

[importlinter:contract:tools-not-cli-frontend]
name = opencodon.tools must not import the CLI frontend
type = forbidden
source_modules = opencodon.tools
forbidden_modules = opencodon.frontends.cli
allow_indirect_imports = True
ignore_imports =
    opencodon.tools.browser_tool -> opencodon.frontends.cli.dep_ensure
    opencodon.tools.delegate_tool -> opencodon.frontends.cli.shell
    opencodon.tools.mcp_tool -> opencodon.frontends.cli.mcp_security
    opencodon.tools.project_tools -> opencodon.frontends.cli.projects_db
    opencodon.tools.terminal_tool -> opencodon.frontends.cli.cron
    opencodon.tools.tts_tool -> opencodon.frontends.cli
    opencodon.tools.xai_http -> opencodon.frontends.cli

[importlinter:contract:core-not-run-agent]
name = opencodon.core must not import the run_agent god-file
type = forbidden
source_modules = opencodon.core
forbidden_modules = opencodon.core.run_agent
allow_indirect_imports = True
ignore_imports =
    opencodon.core.agent_init -> opencodon.core.run_agent
    opencodon.core.agent_runtime_helpers -> opencodon.core.run_agent
    opencodon.core.background_review -> opencodon.core.run_agent
    opencodon.core.chat_completion_helpers -> opencodon.core.run_agent
    opencodon.core.codex_runtime -> opencodon.core.run_agent
    opencodon.core.conversation_loop -> opencodon.core.run_agent
    opencodon.core.curator -> opencodon.core.run_agent
    opencodon.core.system_prompt -> opencodon.core.run_agent
    opencodon.core.tool_executor -> opencodon.core.run_agent
    opencodon.core.transports.codex -> opencodon.core.run_agent

[importlinter:contract:tools-not-run-agent]
name = opencodon.tools must not import the run_agent god-file
type = forbidden
source_modules = opencodon.tools
forbidden_modules = opencodon.core.run_agent
allow_indirect_imports = True
ignore_imports =
    opencodon.tools.delegate_tool -> opencodon.core.run_agent

[importlinter:contract:tools-not-shell]
name = opencodon.tools must not import the classic CLI shell
type = forbidden
source_modules = opencodon.tools
forbidden_modules = opencodon.frontends.cli.shell
allow_indirect_imports = True
ignore_imports =
    opencodon.tools.delegate_tool -> opencodon.frontends.cli.shell

[importlinter:contract:other-frontends-not-shell]
name = gateway / tui / acp must not import the classic CLI shell
type = forbidden
source_modules =
    opencodon.frontends.gateway
    opencodon.frontends.tui
    opencodon.frontends.acp
forbidden_modules = opencodon.frontends.cli.shell
allow_indirect_imports = True
ignore_imports =
    opencodon.frontends.tui.server -> opencodon.frontends.cli.shell
    opencodon.frontends.tui.slash_worker -> opencodon.frontends.cli.shell

[importlinter:contract:lower-layers-purity]
name = opencodon common/config/state/providers/plugins_runtime must not import core, tools, or frontends
type = forbidden
source_modules =
    opencodon.common
    opencodon.config
    opencodon.state
    opencodon.providers
    opencodon.plugins_runtime
    opencodon.toolsets
forbidden_modules =
    opencodon.core
    opencodon.tools
    opencodon.frontends
allow_indirect_imports = True
ignore_imports =
    opencodon.common.model_normalize -> opencodon.core.models
    opencodon.config -> opencodon.core.auth
    opencodon.plugins_runtime -> opencodon.core.profiles
    opencodon.state -> opencodon.core.memory_manager
    opencodon.state -> opencodon.core.message_sanitization
    opencodon.state._compression_state -> opencodon.core.memory_manager
    opencodon.state._compression_state -> opencodon.core.message_sanitization
    opencodon.state._fts -> opencodon.core.memory_manager
    opencodon.state._fts -> opencodon.core.message_sanitization
    opencodon.state._gateway_meta -> opencodon.core.memory_manager
    opencodon.state._gateway_meta -> opencodon.core.message_sanitization
    opencodon.state._handoff -> opencodon.core.memory_manager
    opencodon.state._handoff -> opencodon.core.message_sanitization
    opencodon.state._porting -> opencodon.core.memory_manager
    opencodon.state._porting -> opencodon.core.message_sanitization
    opencodon.state._schema -> opencodon.core.memory_manager
    opencodon.state._schema -> opencodon.core.message_sanitization
    opencodon.state._transcripts -> opencodon.core.agent_runtime_helpers
    opencodon.state._transcripts -> opencodon.core.memory_manager
    opencodon.state._transcripts -> opencodon.core.message_sanitization
    opencodon.common.logging_setup -> opencodon.core.redact
    opencodon.common.route_identity -> opencodon.core.agent_init
    opencodon.config -> opencodon.core.redact
    opencodon.config -> opencodon.core.secret_scope
    opencodon.config -> opencodon.core.skill_utils
    opencodon.config -> opencodon.frontends.cli.credential_lifecycle
    opencodon.config -> opencodon.frontends.cli.mcp_security
    opencodon.config -> opencodon.frontends.cli.secret_prompt
    opencodon.config -> opencodon.frontends.cli.toolset_validation
    opencodon.config.env_loader -> opencodon.core.secret_sources.registry
    opencodon.config.moa_config -> opencodon.core.errors
    opencodon.plugins_runtime -> opencodon.core.browser_provider
    opencodon.plugins_runtime -> opencodon.core.browser_registry
    opencodon.plugins_runtime -> opencodon.core.context_engine
    opencodon.plugins_runtime -> opencodon.core.image_gen_provider
    opencodon.plugins_runtime -> opencodon.core.image_gen_registry
    opencodon.plugins_runtime -> opencodon.core.plugin_llm
    opencodon.plugins_runtime -> opencodon.core.secret_sources.base
    opencodon.plugins_runtime -> opencodon.core.secret_sources.registry
    opencodon.plugins_runtime -> opencodon.core.skill_utils
    opencodon.plugins_runtime -> opencodon.core.transcription_provider
    opencodon.plugins_runtime -> opencodon.core.transcription_registry
    opencodon.plugins_runtime -> opencodon.core.tts_provider
    opencodon.plugins_runtime -> opencodon.core.tts_registry
    opencodon.plugins_runtime -> opencodon.core.web_search_provider
    opencodon.plugins_runtime -> opencodon.core.web_search_registry
    opencodon.plugins_runtime -> opencodon.frontends.cli.commands
    opencodon.plugins_runtime -> opencodon.frontends.cli.dashboard_auth
    opencodon.plugins_runtime -> opencodon.frontends.cli.main
    opencodon.plugins_runtime -> opencodon.frontends.gateway.platform_registry
    opencodon.plugins_runtime -> opencodon.tools.approval
    opencodon.plugins_runtime -> opencodon.tools.registry
    opencodon.providers.base -> opencodon.frontends.cli
    opencodon.toolsets -> opencodon.frontends.gateway.platform_registry
    opencodon.toolsets -> opencodon.tools.registry
