[importlinter]
root_packages =
    opencodon
    agent
    tools
    gateway
    tui_gateway
    acp_adapter
    opencodon_cli
    cron
    providers
# Root single-file modules (cli, run_agent, model_tools, ...) can't be
# root_packages; with include_external_packages they appear as squashed
# external modules, which forbidden contracts can still target.
include_external_packages = True

# Target layering (enforced incrementally by the restructure plan,
# docs/plans/2026-08-01-repo-restructure-plan.md):
#     frontends (opencodon_cli, gateway, tui_gateway, acp_adapter, cli, mcp_serve)
#       -> core (run_agent, agent, model_tools, tools, toolsets, cron, providers)
#       -> state/config (opencodon_state)
#       -> common (opencodon_constants, opencodon_logging, opencodon_time, utils)
#
# Each contract below forbids one inversion of that layering. The
# ignore_imports lists are the GRANDFATHERED baseline (2026-08-01) — they may
# only shrink. Adding a new edge to any list requires explicit maintainer
# sign-off in review; the restructure phases exist to drain them to zero.
# allow_indirect_imports: contracts police direct imports only, so a
# grandfathered edge doesn't cascade into unrelated chain violations.

[importlinter:contract:core-not-cli-pkg]
name = agent must not import the CLI frontend (opencodon_cli)
type = forbidden
source_modules = agent
forbidden_modules = opencodon_cli
allow_indirect_imports = True
ignore_imports =
    agent.account_usage -> opencodon_cli.auth
    agent.account_usage -> opencodon_cli.runtime_provider
    agent.agent_init -> opencodon_cli.auth
    agent.agent_init -> opencodon_cli.config
    agent.agent_init -> opencodon_cli.model_normalize
    agent.agent_init -> opencodon_cli.models
    agent.agent_init -> opencodon_cli.plugins
    agent.agent_init -> opencodon_cli.profiles
    agent.agent_init -> opencodon_cli.providers
    agent.agent_init -> opencodon_cli.route_identity
    agent.agent_init -> opencodon_cli.timeouts
    agent.agent_runtime_helpers -> opencodon_cli.auth
    agent.agent_runtime_helpers -> opencodon_cli.config
    agent.agent_runtime_helpers -> opencodon_cli.middleware
    agent.agent_runtime_helpers -> opencodon_cli.moa_config
    agent.agent_runtime_helpers -> opencodon_cli.plugins
    agent.agent_runtime_helpers -> opencodon_cli.providers
    agent.agent_runtime_helpers -> opencodon_cli.runtime_provider
    agent.agent_runtime_helpers -> opencodon_cli.timeouts
    agent.anthropic_adapter -> opencodon_cli.auth
    agent.auxiliary_client -> opencodon_cli.auth
    agent.auxiliary_client -> opencodon_cli.config
    agent.auxiliary_client -> opencodon_cli.copilot_auth
    agent.auxiliary_client -> opencodon_cli.fallback_config
    agent.auxiliary_client -> opencodon_cli.moa_config
    agent.auxiliary_client -> opencodon_cli.model_normalize
    agent.auxiliary_client -> opencodon_cli.models
    agent.auxiliary_client -> opencodon_cli.plugins
    agent.auxiliary_client -> opencodon_cli.providers
    agent.auxiliary_client -> opencodon_cli.runtime_provider
    agent.background_review -> opencodon_cli.config
    agent.background_review -> opencodon_cli.plugins
    agent.background_review -> opencodon_cli.runtime_provider
    agent.chat_completion_helpers -> opencodon_cli.config
    agent.chat_completion_helpers -> opencodon_cli.model_normalize
    agent.chat_completion_helpers -> opencodon_cli.timeouts
    agent.coding_context -> opencodon_cli._subprocess_compat
    agent.coding_context -> opencodon_cli.config
    agent.coding_context -> opencodon_cli.tools_config
    agent.context_references -> opencodon_cli._subprocess_compat
    agent.conversation_compression -> opencodon_cli.goals
    agent.conversation_loop -> opencodon_cli.middleware
    agent.conversation_loop -> opencodon_cli.moa_config
    agent.conversation_loop -> opencodon_cli.plugins
    agent.credential_pool -> opencodon_cli.auth
    agent.credential_pool -> opencodon_cli.config
    agent.credential_pool -> opencodon_cli.copilot_auth
    agent.credential_pool -> opencodon_cli.env_loader
    agent.credential_sources -> opencodon_cli.auth
    agent.credential_sources -> opencodon_cli.config
    agent.curator -> opencodon_cli.config
    agent.curator -> opencodon_cli.runtime_provider
    agent.curator_backup -> opencodon_cli.config
    agent.display -> opencodon_cli.skin_engine
    agent.gemini_native_adapter -> opencodon_cli
    agent.i18n -> opencodon_cli.config
    agent.image_gen_registry -> opencodon_cli.config
    agent.lsp.install -> opencodon_cli.tools_config
    agent.lsp.manager -> opencodon_cli.config
    agent.moa_loop -> opencodon_cli.config
    agent.moa_loop -> opencodon_cli.moa_config
    agent.moa_loop -> opencodon_cli.runtime_provider
    agent.moa_trace -> opencodon_cli.config
    agent.model_metadata -> opencodon_cli.config
