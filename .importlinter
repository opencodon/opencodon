    agent.model_metadata -> opencodon_cli.runtime_provider
    agent.models_dev -> opencodon_cli.models
    agent.onboarding -> opencodon_cli.config
    agent.plugin_llm -> opencodon_cli.config
    agent.prompt_builder -> opencodon_cli.projects_db
    agent.prompt_builder -> opencodon_cli.config
    agent.secret_scope -> opencodon_cli.env_loader
    agent.shell_hooks -> opencodon_cli._subprocess_compat
    agent.shell_hooks -> opencodon_cli.plugins
    agent.skill_commands -> opencodon_cli.commands
    agent.skill_preprocessing -> opencodon_cli._subprocess_compat
    agent.skill_preprocessing -> opencodon_cli.config
    agent.system_prompt -> opencodon_cli.config
