[importlinter]
root_packages =
    opencodon
    gateway
    tui_gateway
    acp_adapter
    opencodon_cli
include_external_packages = True

# Target layering (docs/plans/2026-08-01-repo-restructure-plan.md):
#   frontends (opencodon_cli, gateway, tui_gateway, acp_adapter, cli, mcp_serve)
#     -> opencodon.core / opencodon.tools / opencodon.cron
#     -> opencodon config/state/plugins_runtime/providers
#     -> opencodon.common (leaf)
# ignore_imports lists are the grandfathered baseline — shrink-only.

[importlinter:contract:core-not-cli-pkg]
name = opencodon.core must not import the CLI frontend (opencodon_cli)
type = forbidden
source_modules = opencodon.core
forbidden_modules = opencodon_cli
allow_indirect_imports = True
ignore_imports =
    opencodon.core.run_agent -> opencodon_cli
    opencodon.core.run_agent -> opencodon_cli.auth
    opencodon.core.run_agent -> opencodon_cli.copilot_auth
    opencodon.core.run_agent -> opencodon_cli.models
    opencodon.core.run_agent -> opencodon_cli.profiles
    opencodon.core.account_usage -> opencodon_cli.auth
    opencodon.core.account_usage -> opencodon_cli.runtime_provider
    opencodon.core.agent_init -> opencodon_cli.auth
    opencodon.core.agent_init -> opencodon_cli.models
    opencodon.core.agent_init -> opencodon_cli.profiles
    opencodon.core.agent_init -> opencodon_cli.providers
    opencodon.core.agent_runtime_helpers -> opencodon_cli.auth
    opencodon.core.agent_runtime_helpers -> opencodon_cli.providers
    opencodon.core.agent_runtime_helpers -> opencodon_cli.runtime_provider
    opencodon.core.anthropic_adapter -> opencodon_cli.auth
    opencodon.core.auxiliary_client -> opencodon_cli.auth
    opencodon.core.auxiliary_client -> opencodon_cli.copilot_auth
    opencodon.core.auxiliary_client -> opencodon_cli.fallback_config
    opencodon.core.auxiliary_client -> opencodon_cli.models
    opencodon.core.auxiliary_client -> opencodon_cli.providers
    opencodon.core.auxiliary_client -> opencodon_cli.runtime_provider
    opencodon.core.background_review -> opencodon_cli.runtime_provider
    opencodon.core.coding_context -> opencodon_cli.tools_config
    opencodon.core.conversation_compression -> opencodon_cli.goals
    opencodon.core.credential_pool -> opencodon_cli.auth
    opencodon.core.credential_pool -> opencodon_cli.copilot_auth
    opencodon.core.credential_sources -> opencodon_cli.auth
    opencodon.core.curator -> opencodon_cli.runtime_provider
    opencodon.core.display -> opencodon_cli.skin_engine
    opencodon.core.gemini_native_adapter -> opencodon_cli
    opencodon.core.lsp.install -> opencodon_cli.tools_config
    opencodon.core.moa_loop -> opencodon_cli.runtime_provider
    opencodon.core.model_metadata -> opencodon_cli.models
    opencodon.core.model_metadata -> opencodon_cli.runtime_provider
    opencodon.core.models_dev -> opencodon_cli.models
    opencodon.core.prompt_builder -> opencodon_cli.projects_db
    opencodon.core.skill_commands -> opencodon_cli.commands

[importlinter:contract:tools-not-cli-pkg]
name = opencodon.tools must not import the CLI frontend (opencodon_cli)
type = forbidden
source_modules = opencodon.tools
forbidden_modules = opencodon_cli
allow_indirect_imports = True
ignore_imports =
    opencodon.tools.browser_tool -> opencodon_cli.dep_ensure
    opencodon.tools.cronjob_tools -> opencodon_cli.auth
    opencodon.tools.cronjob_tools -> opencodon_cli.runtime_provider
    opencodon.tools.delegate_tool -> opencodon_cli.runtime_provider
    opencodon.tools.environments.docker -> opencodon_cli.profiles
    opencodon.tools.environments.local -> opencodon_cli.auth
    opencodon.tools.mcp_tool -> opencodon_cli.mcp_security
    opencodon.tools.model_tools -> opencodon_cli.runtime_provider
    opencodon.tools.project_tools -> opencodon_cli.projects_db
    opencodon.tools.session_search_tool -> opencodon_cli.profiles
    opencodon.tools.terminal_tool -> opencodon_cli.cron
    opencodon.tools.transcription_tools -> opencodon_cli.models
    opencodon.tools.tts_tool -> opencodon_cli
    opencodon.tools.tts_tool -> opencodon_cli.models
    opencodon.tools.xai_http -> opencodon_cli
    opencodon.tools.xai_http -> opencodon_cli.auth

[importlinter:contract:core-not-run-agent]
name = opencodon.core must not import the run_agent god-file
type = forbidden
source_modules = opencodon.core
forbidden_modules = opencodon.core.run_agent
allow_indirect_imports = True
ignore_imports =
    opencodon.core.agent_init -> opencodon.core.run_agent
    opencodon.core.agent_runtime_helpers -> opencodon.core.run_agent
    opencodon.core.background_review -> opencodon.core.run_agent
    opencodon.core.chat_completion_helpers -> opencodon.core.run_agent
    opencodon.core.codex_runtime -> opencodon.core.run_agent
    opencodon.core.conversation_loop -> opencodon.core.run_agent
    opencodon.core.curator -> opencodon.core.run_agent
    opencodon.core.system_prompt -> opencodon.core.run_agent
    opencodon.core.tool_executor -> opencodon.core.run_agent
    opencodon.core.transports.codex -> opencodon.core.run_agent

[importlinter:contract:tools-not-run-agent]
name = opencodon.tools must not import the run_agent god-file
type = forbidden
source_modules = opencodon.tools
forbidden_modules = opencodon.core.run_agent
allow_indirect_imports = True
ignore_imports =
    opencodon.tools.delegate_tool -> opencodon.core.run_agent

[importlinter:contract:tools-not-cli-module]
name = opencodon.tools must not import cli.py
type = forbidden
source_modules = opencodon.tools
forbidden_modules = cli
allow_indirect_imports = True
ignore_imports =
    opencodon.tools.delegate_tool -> cli

[importlinter:contract:frontends-not-cli-module]
name = gateway / tui_gateway / acp_adapter must not import cli.py
type = forbidden
source_modules =
    gateway
    tui_gateway
    acp_adapter
forbidden_modules = cli
allow_indirect_imports = True
ignore_imports =
    tui_gateway.server -> cli
    tui_gateway.slash_worker -> cli

[importlinter:contract:lower-layers-purity]
name = opencodon common/config/state/providers/plugins_runtime must not import core, tools, frontends, or god-files
type = forbidden
source_modules =
    opencodon.common
    opencodon.config
    opencodon.state
    opencodon.providers
    opencodon.plugins_runtime
    opencodon.toolsets
forbidden_modules =
    opencodon.core
    opencodon.tools
    opencodon_cli
    cli
allow_indirect_imports = True
ignore_imports =
    opencodon.common.logging_setup -> opencodon.core.redact
    opencodon.common.model_normalize -> opencodon_cli.models
    opencodon.common.route_identity -> opencodon.core.agent_init
    opencodon.config -> opencodon.core.redact
    opencodon.config -> opencodon.core.secret_scope
    opencodon.config -> opencodon.core.skill_utils
    opencodon.config -> opencodon_cli.auth
    opencodon.config -> opencodon_cli.credential_lifecycle
    opencodon.config -> opencodon_cli.mcp_security
    opencodon.config -> opencodon_cli.secret_prompt
    opencodon.config -> opencodon_cli.toolset_validation
    opencodon.config.env_loader -> opencodon.core.secret_sources.registry
    opencodon.config.moa_config -> opencodon.core.errors
    opencodon.plugins_runtime -> opencodon.core.browser_provider
    opencodon.plugins_runtime -> opencodon.core.browser_registry
    opencodon.plugins_runtime -> opencodon.core.context_engine
    opencodon.plugins_runtime -> opencodon.core.image_gen_provider
    opencodon.plugins_runtime -> opencodon.core.image_gen_registry
    opencodon.plugins_runtime -> opencodon.core.plugin_llm
    opencodon.plugins_runtime -> opencodon.core.secret_sources.base
    opencodon.plugins_runtime -> opencodon.core.secret_sources.registry
    opencodon.plugins_runtime -> opencodon.core.skill_utils
    opencodon.plugins_runtime -> opencodon.core.transcription_provider
    opencodon.plugins_runtime -> opencodon.core.transcription_registry
    opencodon.plugins_runtime -> opencodon.core.tts_provider
    opencodon.plugins_runtime -> opencodon.core.tts_registry
    opencodon.plugins_runtime -> opencodon.core.web_search_provider
    opencodon.plugins_runtime -> opencodon.core.web_search_registry
    opencodon.plugins_runtime -> opencodon.tools.approval
    opencodon.plugins_runtime -> opencodon.tools.registry
    opencodon.plugins_runtime -> opencodon_cli.commands
    opencodon.plugins_runtime -> opencodon_cli.dashboard_auth
    opencodon.plugins_runtime -> opencodon_cli.main
    opencodon.plugins_runtime -> opencodon_cli.profiles
    opencodon.providers.base -> opencodon_cli
    opencodon.providers.base -> opencodon_cli.urllib_security
    opencodon.state -> opencodon.core.agent_runtime_helpers
    opencodon.state -> opencodon.core.memory_manager
    opencodon.state -> opencodon.core.message_sanitization
    opencodon.toolsets -> opencodon.tools.registry
