[importlinter:contract:agent-not-run-agent]
name = agent package must not import the run_agent god-file
type = forbidden
source_modules = agent
forbidden_modules = run_agent
allow_indirect_imports = True
ignore_imports =
    agent.agent_init -> run_agent
    agent.agent_runtime_helpers -> run_agent
    agent.background_review -> run_agent
    agent.chat_completion_helpers -> run_agent
    agent.codex_runtime -> run_agent
    agent.conversation_loop -> run_agent
    agent.curator -> run_agent
    agent.system_prompt -> run_agent
    agent.tool_executor -> run_agent
    agent.transports.codex -> run_agent

[importlinter:contract:tools-not-run-agent]
name = tools must not import the run_agent god-file
type = forbidden
source_modules = tools
forbidden_modules = run_agent
allow_indirect_imports = True
ignore_imports =
    tools.delegate_tool -> run_agent

[importlinter:contract:tools-not-cli-module]
name = tools must not import cli.py
type = forbidden
source_modules = tools
forbidden_modules = cli
allow_indirect_imports = True
ignore_imports =
    tools.delegate_tool -> cli

[importlinter:contract:frontends-not-cli-module]
name = gateway / tui_gateway / acp_adapter must not import cli.py
type = forbidden
source_modules =
    gateway
    tui_gateway
    acp_adapter
forbidden_modules = cli
allow_indirect_imports = True
ignore_imports =
    tui_gateway.server -> cli
    tui_gateway.slash_worker -> cli

[importlinter:contract:opencodon-layer-purity]
name = opencodon package must not import frontends or core god-files
type = forbidden
source_modules = opencodon
forbidden_modules =
    opencodon_cli
    agent
    tools
    cli
    run_agent
    model_tools
allow_indirect_imports = True
ignore_imports =
    opencodon.common.constants -> opencodon_cli._subprocess_compat
    opencodon.common.logging_setup -> agent.redact
    opencodon.common.route_identity -> agent.agent_init
    opencodon.config -> agent.redact
    opencodon.config -> agent.secret_scope
    opencodon.config -> agent.skill_utils
    opencodon.config -> opencodon_cli.auth
    opencodon.config -> opencodon_cli.credential_lifecycle
    opencodon.config -> opencodon_cli.mcp_security
    opencodon.config -> opencodon_cli.secret_prompt
    opencodon.config -> opencodon_cli.toolset_validation
    opencodon.toolsets -> tools.registry
