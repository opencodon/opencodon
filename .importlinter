[importlinter:contract:agent-not-run-agent]
name = agent package must not import the run_agent god-file
type = forbidden
source_modules = agent
forbidden_modules = run_agent
allow_indirect_imports = True
ignore_imports =
    agent.agent_init -> run_agent
    agent.agent_runtime_helpers -> run_agent
    agent.background_review -> run_agent
    agent.chat_completion_helpers -> run_agent
    agent.codex_runtime -> run_agent
    agent.conversation_loop -> run_agent
    agent.curator -> run_agent
    agent.system_prompt -> run_agent
    agent.tool_executor -> run_agent
    agent.transports.codex -> run_agent

[importlinter:contract:tools-not-run-agent]
name = tools must not import the run_agent god-file
type = forbidden
source_modules = tools
forbidden_modules = run_agent
allow_indirect_imports = True
ignore_imports =
    tools.delegate_tool -> run_agent

[importlinter:contract:tools-not-cli-module]
name = tools must not import cli.py
type = forbidden
source_modules = tools
forbidden_modules = cli
allow_indirect_imports = True
ignore_imports =
    tools.delegate_tool -> cli

[importlinter:contract:frontends-not-cli-module]
name = gateway / tui_gateway / acp_adapter must not import cli.py
type = forbidden
source_modules =
    gateway
    tui_gateway
    acp_adapter
forbidden_modules = cli
allow_indirect_imports = True
ignore_imports =
    gateway.run -> cli
    gateway.slash_commands -> cli
    tui_gateway.server -> cli
    tui_gateway.slash_worker -> cli
